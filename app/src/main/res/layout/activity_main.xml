<?xml version="1.0" encoding="utf-8"?>
<!-- Main calculator layout with a dark theme -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black"
    tools:context=".MainActivity">

    <!-- Display Area - Shows current input and calculation results -->
    <TextView
        android:id="@+id/display"
        android:layout_width="0dp"
        android:layout_height="120dp"
        android:layout_margin="16dp"
        android:background="#1A1A1A"
        android:gravity="end|center_vertical"
        android:text="0"
        android:textSize="40sp"
        android:textColor="@android:color/white"
        android:padding="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Calculator Buttons Grid - Organized in a 5x4 grid layout -->
    <GridLayout
        android:id="@+id/buttonGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_margin="16dp"
        android:rowCount="5"
        android:columnCount="4"
        android:useDefaultMargins="true"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintTop_toBottomOf="@id/display"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Row 1: Clear, Parentheses, and Division -->
        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btnClear" 
            android:text="C" 
            android:textSize="24sp" 
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1" 
            android:layout_columnWeight="1" 
            android:layout_margin="4dp"
            android:textColor="@android:color/white" 
            app:backgroundTint="#4A4A4A"
            style="@style/Widget.MaterialComponents.Button" />

        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btnLeftParen" 
            android:text="(" 
            android:textSize="24sp" 
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1" 
            android:layout_columnWeight="1" 
            android:layout_margin="4dp"
            android:textColor="@android:color/white" 
            app:backgroundTint="#4A4A4A"
            style="@style/Widget.MaterialComponents.Button" />

        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btnRightParen" 
            android:text=")" 
            android:textSize="24sp" 
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1" 
            android:layout_columnWeight="1" 
            android:layout_margin="4dp"
            android:textColor="@android:color/white" 
            app:backgroundTint="#4A4A4A"
            style="@style/Widget.MaterialComponents.Button" />

        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btnDivide" 
            android:text="÷" 
            android:textSize="24sp" 
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1" 
            android:layout_columnWeight="1" 
            android:layout_margin="4dp"
            android:textColor="@android:color/white" 
            app:backgroundTint="#4A4A4A"
            style="@style/Widget.MaterialComponents.Button" />

        <!-- Row 2: Numbers 7-9 and Multiplication -->
        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btn7" 
            android:text="7" 
            android:textSize="24sp" 
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1" 
            android:layout_columnWeight="1" 
            android:layout_margin="4dp"
            android:textColor="@android:color/white" 
            app:backgroundTint="#4A4A4A"
            style="@style/Widget.MaterialComponents.Button" />

        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btn8" 
            android:text="8" 
            android:textSize="24sp" 
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1" 
            android:layout_columnWeight="1" 
            android:layout_margin="4dp"
            android:textColor="@android:color/white" 
            app:backgroundTint="#4A4A4A"
            style="@style/Widget.MaterialComponents.Button" />

        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btn9" 
            android:text="9" 
            android:textSize="24sp" 
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1" 
            android:layout_columnWeight="1" 
            android:layout_margin="4dp"
            android:textColor="@android:color/white" 
            app:backgroundTint="#4A4A4A"
            style="@style/Widget.MaterialComponents.Button" />

        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btnMultiply" 
            android:text="×" 
            android:textSize="24sp" 
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1" 
            android:layout_columnWeight="1" 
            android:layout_margin="4dp"
            android:textColor="@android:color/white" 
            app:backgroundTint="#4A4A4A"
            style="@style/Widget.MaterialComponents.Button" />

        <!-- Row 3: Numbers 4-6 and Subtraction -->
        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btn4" 
            android:text="4" 
            android:textSize="24sp" 
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1" 
            android:layout_columnWeight="1" 
            android:layout_margin="4dp"
            android:textColor="@android:color/white" 
            app:backgroundTint="#4A4A4A"
            style="@style/Widget.MaterialComponents.Button" />

        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btn5" 
            android:text="5" 
            android:textSize="24sp" 
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1" 
            android:layout_columnWeight="1" 
            android:layout_margin="4dp"
            android:textColor="@android:color/white" 
            app:backgroundTint="#4A4A4A"
            style="@style/Widget.MaterialComponents.Button" />

        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btn6" 
            android:text="6" 
            android:textSize="24sp" 
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1" 
            android:layout_columnWeight="1" 
            android:layout_margin="4dp"
            android:textColor="@android:color/white" 
            app:backgroundTint="#4A4A4A"
            style="@style/Widget.MaterialComponents.Button" />

        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btnMinus" 
            android:text="-" 
            android:textSize="24sp" 
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1" 
            android:layout_columnWeight="1" 
            android:layout_margin="4dp"
            android:textColor="@android:color/white" 
            app:backgroundTint="#4A4A4A"
            style="@style/Widget.MaterialComponents.Button" />

        <!-- Row 4: Numbers 1-3 and Addition -->
        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btn1" 
            android:text="1" 
            android:textSize="24sp" 
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1" 
            android:layout_columnWeight="1" 
            android:layout_margin="4dp"
            android:textColor="@android:color/white" 
            app:backgroundTint="#4A4A4A"
            style="@style/Widget.MaterialComponents.Button" />

        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btn2" 
            android:text="2" 
            android:textSize="24sp" 
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1" 
            android:layout_columnWeight="1" 
            android:layout_margin="4dp"
            android:textColor="@android:color/white" 
            app:backgroundTint="#4A4A4A"
            style="@style/Widget.MaterialComponents.Button" />

        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btn3" 
            android:text="3" 
            android:textSize="24sp" 
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1" 
            android:layout_columnWeight="1" 
            android:layout_margin="4dp"
            android:textColor="@android:color/white" 
            app:backgroundTint="#4A4A4A"
            style="@style/Widget.MaterialComponents.Button" />

        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btnPlus" 
            android:text="+" 
            android:textSize="24sp" 
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1" 
            android:layout_columnWeight="1" 
            android:layout_margin="4dp"
            android:textColor="@android:color/white" 
            app:backgroundTint="#4A4A4A"
            style="@style/Widget.MaterialComponents.Button" />

        <!-- Row 5: Zero, Decimal Point, Square Root, and Equals -->
        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btn0" 
            android:text="0" 
            android:textSize="24sp" 
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1" 
            android:layout_columnWeight="1" 
            android:layout_margin="4dp"
            android:textColor="@android:color/white" 
            app:backgroundTint="#4A4A4A"
            style="@style/Widget.MaterialComponents.Button" />

        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btnDot" 
            android:text="." 
            android:textSize="24sp" 
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1" 
            android:layout_columnWeight="1" 
            android:layout_margin="4dp"
            android:textColor="@android:color/white" 
            app:backgroundTint="#4A4A4A"
            style="@style/Widget.MaterialComponents.Button" />

        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btnSqrt" 
            android:text="√" 
            android:textSize="24sp" 
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1" 
            android:layout_columnWeight="1" 
            android:layout_margin="4dp"
            android:textColor="@android:color/white" 
            app:backgroundTint="#4A4A4A"
            style="@style/Widget.MaterialComponents.Button" />

        <com.google.android.material.button.MaterialButton 
            android:id="@+id/btnEquals" 
            android:text="=" 
            android:textSize="24sp" 
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_rowWeight="1" 
            android:layout_columnWeight="1" 
            android:layout_margin="4dp"
            android:textColor="@android:color/white" 
            app:backgroundTint="#4A4A4A"
            style="@style/Widget.MaterialComponents.Button" />

    </GridLayout>

</androidx.constraintlayout.widget.ConstraintLayout>